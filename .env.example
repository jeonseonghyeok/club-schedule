# 개발 서버 Docker 앱용 — /opt/club-schedule/.env 로 복사 후 값 입력 (.env 는 커밋 금지)
#
# app-network (172.19.0.0/16): nginx, club-schedule, mariadb-dev
# club-schedule 컨테이너는 DB 호스트명으로 mariadb-dev 를 사용한다 (같은 bridge DNS).
#
# 로컬 Eclipse 도 동일 app_dev 를 쓰려면:
#   mariadb-dev 에 호스트 바인딩 127.0.0.1:3307:3306 가 있어야 하고(3306은 mariadb-prod가 사용 중),
#   scripts/start-db-tunnel.ps1 로 localhost:3307 에 포워딩한다.
#
# Spring Boot 는 DATASOURCE_URL → datasource_url 등 환경변수를 자동 매핑한다.

DATASOURCE_URL=jdbc:mariadb://mariadb-dev:3306/app_dev?allowMultiQueries=true
DATASOURCE_USERNAME=
DATASOURCE_PASSWORD=

KAKAO_REST_KEY=
KAKAO_TOKEN_ISSUE_URL=https://kauth.kakao.com/oauth/token
KAKAO_REDIRECT_WHITELIST=/login/kakao/login_callback
KAKAO_CLIENT_SECRET_KEY=

# 운영 환경에서는 비워둬서 /login/test 테스트 로그인을 비활성화한다.
TEST_AUTH_SECRET=
