# club-schedule 백엔드 환경변수 — 서버의 ~/services/club-schedule/<env>.env 로 복사 후 값 입력
# (<env> = dev | prod, 권한 600, 커밋 금지). deploy/compose.yml 이 env_file 로 읽는다.
#
# 컨테이너는 app-network 에서 DB 호스트명 mariadb-dev / mariadb-prod 로 접속한다.
# 서버에서 bootRun 으로 직접 띄울 때는 127.0.0.1:3307(dev) / 127.0.0.1:3306(prod) 를 쓴다.
#
# Spring Boot 는 DATASOURCE_URL → datasource_url 등 환경변수를 자동 매핑한다.

DATASOURCE_URL=jdbc:mariadb://mariadb-dev:3306/app_dev?allowMultiQueries=true
DATASOURCE_USERNAME=
DATASOURCE_PASSWORD=

KAKAO_REST_KEY=
KAKAO_TOKEN_ISSUE_URL=https://kauth.kakao.com/oauth/token
KAKAO_REDIRECT_WHITELIST=/login/kakao/login_callback
KAKAO_CLIENT_SECRET_KEY=

# 운영 환경에서는 비워둬서 /login/test 테스트 로그인을 비활성화한다.
TEST_AUTH_SECRET=
